        <mxCell id="G4yzIHdy1dtviLtXwAN6-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;ol style=&quot;line-height: 160%;&quot;&gt;&lt;br&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Tank size: &lt;b&gt;180 l&lt;/b&gt; (could be for a F1155) vs &lt;b&gt;500 l&lt;/b&gt; (VVM 500)&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Overproduction &lt;b&gt;2, 4, 6, 8 Kw&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Compressor: &lt;b&gt;On&lt;/b&gt; or &lt;b&gt;Off&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;ol&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Compressor &lt;b&gt;On&lt;/b&gt; (at min):  0.65, 2.9,   5.15, 7.4,   9.65 (kW)&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Compressor &lt;b&gt;Off&lt;/b&gt;:                        2.25, 4.5,   6.75, 9 (kW)&lt;/li&gt;&lt;/ol&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Start Temperature: 45 - 50c&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;End temperature: To 60 - 65c&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="200" width="379.75" x="1550.25" y="-388" as="geometry" />
        </mxCell>
        <mxCell id="G4yzIHdy1dtviLtXwAN6-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Variables&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="20.4" width="155.75" x="1654.25" y="-378.4" as="geometry" />
        </mxCell>
        <mxCell id="G4yzIHdy1dtviLtXwAN6-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;ul style=&quot;line-height: 180%;&quot;&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="458" width="474" x="1964.5" y="-388" as="geometry" />
        </mxCell>
        <mxCell id="G4yzIHdy1dtviLtXwAN6-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;ul style=&quot;line-height: 160%;&quot;&gt;&lt;li&gt;The standard temperature in heat pumps seems to be 45 - 50 c&lt;/li&gt;&lt;li&gt;The temperature in the tank doesn&#39;t usually go over 60c&lt;/li&gt;&lt;li&gt;High temperatures in heat pumps can cause burns if you don&#39;t have a mixing valve        (5 sec in 60c water - 3rd degree burns)&lt;/li&gt;&lt;li&gt;Limescale buildup accelerates dramatically as temperatures rise above 65c&lt;/li&gt;&lt;li&gt;The tank loses temperature faster at higher temps&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="125.48" width="451.5" x="1978.5" y="-325.48" as="geometry" />
        </mxCell>
        <mxCell id="G4yzIHdy1dtviLtXwAN6-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Optimal Max Temperature&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40.4" width="164.13" x="2120.5" y="-380" as="geometry" />
        </mxCell>
        <mxCell id="G4yzIHdy1dtviLtXwAN6-13" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;imageBorder=default;" value="" vertex="1">
          <mxGeometry height="249" width="267.02" x="1978.5" y="-189" as="geometry" />
        </mxCell>
        <mxCell id="G4yzIHdy1dtviLtXwAN6-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;div style=&quot;line-height: 140%;&quot;&gt;&lt;font style=&quot;font-size: 21px; line-height: 140%;&quot;&gt;&lt;b&gt;&lt;i&gt;Answer&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; line-height: 140%;&quot;&gt;Probably 60 - 65c&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px; line-height: 140%;&quot;&gt;(because of the limescale buildup)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="99.36" width="156.13" x="2261.74" y="-114.18" as="geometry" />
        </mxCell>
