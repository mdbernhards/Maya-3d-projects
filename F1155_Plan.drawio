; letter-spacing: normal; line-height: 24px; --gds-type-scale-default-wdth: &amp;quot;wdth&amp;quot; 95; font-variation-settings: &amp;quot;ROND&amp;quot; 0, &amp;quot;slnt&amp;quot; 0, &amp;quot;wdth&amp;quot; 95;&quot;&gt;&lt;b data-path-to-node=&quot;0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Nibe RAM-Safe Control (Concise Guide)&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;1&quot; style=&quot;margin: 0px 0px 8px; overflow-wrap: anywhere;&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;1. Setup (On the pump display)&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;2&quot; style=&quot;margin: 8px 0px 16px; list-style-type: disc; padding-inline-start: 1.6875rem;&quot;&gt;&lt;li style=&quot;margin: 8px 0px; padding-inline-start: 4px;&quot;&gt;&lt;p data-path-to-node=&quot;2,0,0&quot; style=&quot;margin: 8px 0px; overflow-wrap: anywhere; padding-inline-start: 4px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Hold &lt;b data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;5&quot;&gt;Back button&lt;/b&gt; (7s) → &lt;b data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;24&quot;&gt;Service Menu 5.4&lt;/b&gt; (Soft/AUX inputs).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin: 8px 0px; padding-inline-start: 4px;&quot;&gt;&lt;p data-path-to-node=&quot;2,1,0&quot; style=&quot;margin: 8px 0px; overflow-wrap: anywhere; padding-inline-start: 4px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Set &lt;b data-path-to-node=&quot;2,1,0&quot; data-index-in-node=&quot;4&quot;&gt;Soft Input 1&lt;/b&gt; to: &lt;b data-path-to-node=&quot;2,1,0&quot; data-index-in-node=&quot;21&quot;&gt;&quot;Block compressor&quot;&lt;/b&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin: 8px 0px; padding-inline-start: 4px;&quot;&gt;&lt;p data-path-to-node=&quot;2,2,0&